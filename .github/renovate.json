{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "prConcurrentLimit": 3,
  "schedule": [
    "* 0-5 1,15 * *"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "description": "Cargo: raise the version in Cargo.toml, not only the lock file",
      "matchDatasources": [
        "cargo"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Every Rust crate update in one pull request, majors included; give a crate its own rule to split it out",
      "matchDatasources": [
        "cargo"
      ],
      "groupName": "Rust dependencies",
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    },
    {
      "description": "Every GitHub Actions update in one pull request",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ],
  "vulnerabilityAlerts": {
    "description": "A security fix is a fix: it makes a release",
    "semanticCommitType": "fix"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "* 0-5 1,15 * *"
    ]
  }
}
