<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.maio.engine.ace-step</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--project</string><string>__MAIO__/engine</string>
    <string>--extra</string><string>ace-step</string>
    <string>maio-engine</string>
    <string>--backend</string><string>ace-step</string>
    <string>--ace-root</string><string>__ACE_ROOT__</string>
    <string>--port</string><string>7801</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>MAIO_ENGINE_TOKEN</key><string>__TOKEN__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/maio-engine.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/maio-engine.log</string>
</dict>
</plist>
