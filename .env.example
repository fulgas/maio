# The one account, made on first start; later starts ignore these.
MAIO_ADMIN_USER=
MAIO_ADMIN_PASSWORD=
# For scripts: at least 32 characters, sent as "Authorization: Bearer <token>". Leave empty for none.
MAIO_API_TOKEN=
# ANTHROPIC_API_KEY=
# Send traces, metrics and logs to an OpenTelemetry collector (OTLP over HTTP), for example http://otel-collector:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=maio
# RUST_LOG=info
